# Normaliza quebras de linha para LF no repositório, independente do SO de
# cada integrante da squad (evita diffs de arquivo inteiro por CRLF x LF).
* text=auto eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.hs   text eol=lf
*.md   text eol=lf
Makefile text eol=lf
*.png  binary
*.jpg  binary
*.ico  binary
