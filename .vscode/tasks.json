{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/code/src/*.c",
                "${workspaceFolder}/code/src/*/*.c",
                "-I", "${workspaceFolder}/code/src",
                "-I", "${workspaceFolder}/code/src/core",
                "-I", "${workspaceFolder}/code/src/screens",
                "-I", "${workspaceFolder}/code/src/ui",
                "-I", "${workspaceFolder}/code/src/game",
                "-o",
                "${workspaceFolder}/iara.exe",
                "-I", "C:/msys64/ucrt64/include",
                "-L", "C:/msys64/ucrt64/lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run raylib",
            "type": "shell",
            "command": "${workspaceFolder}/iara.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "build raylib",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
