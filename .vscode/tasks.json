{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/engine-c/src/main.c",
                "-o",
                "${workspaceFolder}/engine-c/src/iara.exe",
                "-I", "C:/msys64/ucrt64/include",
                "-L", "C:/msys64/ucrt64/lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run raylib",
            "type": "shell",
            "command": "${workspaceFolder}/engine-c/src/iara.exe",
            "dependsOn": "build raylib",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        }
    ]
}