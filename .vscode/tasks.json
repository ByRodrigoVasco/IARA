{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "${workspaceFolder}/code/src/*.c",
                "${workspaceFolder}/code/src/core/*.c",
                "${workspaceFolder}/code/src/game/*.c",
                "${workspaceFolder}/code/src/screens/*.c",
                "${workspaceFolder}/code/src/ui/*.c",
                "-I", "${workspaceFolder}/code/src",
                "-I", "${workspaceFolder}/code/src/core",
                "-I", "${workspaceFolder}/code/src/screens",
                "-I", "${workspaceFolder}/code/src/ui",
                "-I", "${workspaceFolder}/code/src/game",
                "-o", "${workspaceFolder}/iara.exe",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run raylib",
            "type": "shell",
            "command": "${workspaceFolder}/iara.exe",
            "dependsOn": "build raylib",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        }
    ]
}